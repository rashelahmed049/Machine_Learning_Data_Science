import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error

np.random.seed(42)
x = np.random.randint(20,30,5000).reshape(-1,1)
y = np.random.randint(50,100,5000)

xtrain,xtest,ytrain,ytest = train_test_split(x,y,random_state=42,test_size=0.2)

def train_model(degree):
  p = PolynomialFeatures(degree)
  x_p_train = p.fit_transform(xtrain)
  x_p_test = p.transform(xtest)

  model = LinearRegression()
  model.fit(x_p_train,ytrain)
  y_p_train = model.predict(x_p_train)
  y_p_test = model.predict(x_p_test)

  train_error = mean_squared_error(y_p_train,ytrain)
  test_error =  mean_squared_error(y_p_test,ytest)

  print("Poly : ",p,"\nTrain_error",train_error,"\nTest error:",test_error)

train_model(2)


